# Server-side only. Never prefix this variable with NEXT_PUBLIC_.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional AI overrides. Defaults also live in lib/site-data.ts.
GEMINI_MODEL=gemini-2.5-flash-lite
AI_LIMIT_PER_10_MINUTES=5
AI_LIMIT_PER_DAY=15

# Canonical production URL. Chatbot links use the active request host automatically.
NEXT_PUBLIC_SITE_URL=https://www.pemenanglawfirm.com

# WhatsApp single source. Use digits only; an Indonesian 08... value is normalized to 62....
# Category variables override the built-in product defaults when provided.
NEXT_PUBLIC_WHATSAPP_DEFAULT=6282245686979
NEXT_PUBLIC_WHATSAPP_MARINE_CARGO=6281331831044
NEXT_PUBLIC_WHATSAPP_MARINE_HULL=6282231222245
NEXT_PUBLIC_WHATSAPP_FIRE_PROPERTY=6285755786252
NEXT_PUBLIC_WHATSAPP_MOTOR_VEHICLE=6281253996580
NEXT_PUBLIC_WHATSAPP_TRAVEL=6282245686979
NEXT_PUBLIC_WHATSAPP_LIABILITY=6282245686979
NEXT_PUBLIC_WHATSAPP_CLAIM=6282245686979

# The law firm site is now served from this same domain at /pml (see siteRoutes.pml).

# WhatsApp number for the PML Law Firm entry in the WhatsApp Contact list. Digits only.
NEXT_PUBLIC_WHATSAPP_LAW_FIRM=6289638714065
